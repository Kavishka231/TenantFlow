{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TenantFlow development demo fixture",
  "type": "object",
  "required": ["notice", "organization", "customers", "deals", "invoice", "expenses"],
  "properties": {
    "$schema": { "type": "string" },
    "notice": { "type": "string" },
    "organization": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      },
      "additionalProperties": false
    },
    "customers": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "deals": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "invoice": { "type": "object" },
    "expenses": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  },
  "additionalProperties": false
}
