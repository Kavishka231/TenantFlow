# Copy to .env.compose.local and keep that file untracked.
TENANTFLOW_ENV_FILE=.env.compose.local

# Browser-safe values are also passed as frontend image build arguments.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Restricted runtime connection only: non-owner, non-superuser, no BYPASSRLS.
DATABASE_URL=postgresql://application_user:password@host:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_JWT_AUDIENCE=authenticated

TENANTFLOW_BACKEND=fastapi
FASTAPI_INTERNAL_URL=http://backend:8000
STRIPE_WEBHOOK_PROCESSOR=disabled

# Optional Stripe Test Mode values. Configure the complete set together.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_STARTER_PRICE_ID=price_replace_me
# STRIPE_GROWTH_PRICE_ID=price_replace_me
# STRIPE_WEBHOOK_DATABASE_URL=postgresql://stripe_webhook_user:password@host:5432/postgres?sslmode=require
