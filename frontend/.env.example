# Browser-safe application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only direct PostgreSQL connection. Use a non-privileged application role
# whose grants and RLS behavior match production; never prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://application_user:password@host:5432/postgres?sslmode=require

# Server-only DDL connection used exclusively by Drizzle Kit commands.
MIGRATION_DATABASE_URL=postgresql://migration_user:password@host:5432/postgres?sslmode=require

# Optional server-only invitation delivery webhook. Configure both values together.
# The webhook receives the intended recipient and one-time acceptance URL.
INVITATION_DELIVERY_WEBHOOK_URL=https://mailer.example.com/tenantflow/invitations
INVITATION_DELIVERY_WEBHOOK_SECRET=replace-with-at-least-16-random-characters

# Development-only fallback. Writes acceptance URLs to the gitignored
# frontend/.tenantflow-dev/invitations directory. Never enable in production.
INVITATION_DEV_OUTBOX=false

# Stripe Test Mode billing. Secret and webhook values are server-only. Price IDs
# must reference recurring test-mode Prices whose amounts match the plan catalog.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_STARTER_PRICE_ID=price_replace_me
STRIPE_GROWTH_PRICE_ID=price_replace_me
# Dedicated login that inherits only tenantflow_stripe_webhook. It must not own
# tables, inherit authenticated, or have BYPASSRLS/superuser privileges.
STRIPE_WEBHOOK_DATABASE_URL=postgresql://stripe_webhook_user:password@host:5432/postgres?sslmode=require

# Optional integration-test identities. Create these users through Supabase Auth first.
RLS_TEST_OWNER_ID=00000000-0000-4000-8000-000000000001
RLS_TEST_ADMIN_ID=00000000-0000-4000-8000-000000000002
RLS_TEST_MEMBER_ID=00000000-0000-4000-8000-000000000003
RLS_TEST_OUTSIDER_ID=00000000-0000-4000-8000-000000000004

# Optional live Playwright accounts. Use disposable, confirmed development users.
E2E_USER_EMAIL=owner@example.com
E2E_USER_PASSWORD=replace-with-a-test-password
E2E_SECOND_USER_EMAIL=outsider@example.com
E2E_SECOND_USER_PASSWORD=replace-with-a-test-password
E2E_BASE_URL=http://127.0.0.1:3100
