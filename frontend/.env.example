# Browser-safe application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only direct PostgreSQL connection. Use a non-privileged application role
# whose grants and RLS behavior match production; never prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://application_user:password@host:5432/postgres?sslmode=require

# Server-only DDL connection used exclusively by Drizzle Kit commands.
MIGRATION_DATABASE_URL=postgresql://migration_user:password@host:5432/postgres?sslmode=require

# Optional integration-test identities. Create these users through Supabase Auth first.
RLS_TEST_OWNER_ID=00000000-0000-4000-8000-000000000001
RLS_TEST_ADMIN_ID=00000000-0000-4000-8000-000000000002
RLS_TEST_MEMBER_ID=00000000-0000-4000-8000-000000000003
RLS_TEST_OUTSIDER_ID=00000000-0000-4000-8000-000000000004
